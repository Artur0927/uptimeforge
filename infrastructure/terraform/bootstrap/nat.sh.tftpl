#!/bin/bash
# Cloud-init user data, executes as root on the NAT EC2 at first boot.
# NAT is intentionally restricted to forwarding outbound TCP/80 and TCP/443.
set -euxo pipefail

# AL2023: iptables-services makes firewall rules persist across reboot.
dnf install -y iptables-services

cat >/etc/sysctl.d/90-uptimeforge-ip-forward.conf <<'SYSCTL'
net.ipv4.ip_forward = 1
SYSCTL
sysctl -p /etc/sysctl.d/90-uptimeforge-ip-forward.conf

# Detect the primary interface instead of assuming eth0 or ens5.
PRIMARY_IF=$(ip -o -4 route show default | awk '{print $5; exit}')
test -n "$PRIMARY_IF"

# Save restrictive forwarding policy and SNAT for the private subnet.
# The FORWARD chain allows new outbound HTTP/HTTPS and their replies only.
cat >/etc/sysconfig/iptables <<IPTABLES
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A FORWARD -s ${private_subnet_cidr} -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW,ESTABLISHED -j ACCEPT
-A FORWARD -d ${private_subnet_cidr} -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A POSTROUTING -s ${private_subnet_cidr} -o $PRIMARY_IF -j MASQUERADE
COMMIT
IPTABLES

systemctl enable --now iptables
iptables -t nat -S
iptables -S FORWARD
sysctl net.ipv4.ip_forward
