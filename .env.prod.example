# Placeholder values only. Copy to a private .env.prod and replace every REPLACE_ value.
# Keep this file protected (chmod 600); never put AWS access keys here.
APP_IMAGE=REPLACE_WITH_ECR_REPOSITORY_URL:sha-REPLACE_WITH_40_HEX_COMMIT_SHA
DOCKER_HOST_PRIVATE_IP=REPLACE_WITH_DOCKER_HOST_PRIVATE_IP
NGINX_PRIVATE_IP=REPLACE_WITH_NGINX_PRIVATE_IP
# Fresh install: explicitly provision this volume after approval; upgrade: use actual existing mount.
POSTGRES_VOLUME_NAME=REPLACE_WITH_APPROVED_VOLUME_NAME
POSTGRES_DB=REPLACE_WITH_DATABASE_NAME
POSTGRES_USER=REPLACE_WITH_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# URL-encode username/password components. Keep credentials consistent with PostgreSQL.
DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@db:5432/REPLACE_DATABASE
AUTH_USERNAME=REPLACE_WITH_ADMIN_USERNAME
AUTH_PASSWORD=REPLACE_WITH_LONG_RANDOM_ADMIN_PASSWORD
CHECK_TIMEOUT_SECONDS=10
MAX_RESPONSE_BYTES=1048576
WORKER_POLL_SECONDS=5
WORKER_CONCURRENCY=2
